@model SchoolManager.Dtos.GradeImportConfirmSummaryDto
@{
    ViewData["Title"] = "Importación completada";
    Layout = "_AdminLayout";
    var omitted = Model.OmittedOperations ?? new List<SchoolManager.Dtos.GradeImportOperationDto>();
}

<div class="container-fluid py-4">
    @if (Model.OmittedCount > 0)
    {
        <div class="alert alert-warning">
            <h2 class="h4 mb-0"><i class="fas fa-check-circle"></i> Importación parcial completada</h2>
        </div>
    }
    else
    {
        <div class="alert alert-success">
            <h2 class="h4 mb-0"><i class="fas fa-check-circle"></i> Importación completada</h2>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="row mb-2">
                <div class="col-md-4"><strong>Archivo:</strong> @Model.FileName</div>
                <div class="col-md-4"><strong>Año:</strong> @Model.AcademicYearName</div>
                <div class="col-md-4"><strong>Procesadas:</strong> @Model.Processed</div>
            </div>
            <div class="row mb-2">
                <div class="col-md-3"><span class="badge bg-success">NUEVO @Model.NewCount</span></div>
                <div class="col-md-3"><span class="badge bg-warning text-dark">ACTUALIZAR @Model.UpdateCount</span></div>
                <div class="col-md-3"><span class="badge bg-secondary">SIN CAMBIOS @Model.UnchangedCount</span></div>
                <div class="col-md-3"><span class="badge bg-danger">OMITIDAS POR ERROR @Model.OmittedCount</span></div>
            </div>
            <div class="row">
                <div class="col-md-6"><strong>Fecha:</strong> @Model.CompletedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                <div class="col-md-6"><strong>Usuario:</strong> @Model.UserName</div>
            </div>
        </div>
    </div>

    @if (omitted.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header">Filas omitidas — corríjalas y vuelva a subirlas</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Estado</th>
                                <th>Fila</th>
                                <th>Documento</th>
                                <th>Estudiante</th>
                                <th>Asignatura</th>
                                <th>Grado</th>
                                <th>Grupo</th>
                                <th>Trimestre</th>
                                <th>Observación</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var op in omitted)
                        {
                            <tr>
                                <td><span class="badge bg-danger">OMITIDA POR ERROR</span></td>
                                <td>@op.RowNumber</td>
                                <td>@op.DocumentId</td>
                                <td>@op.StudentName</td>
                                <td>@op.SubjectName</td>
                                <td>@op.GradeName</td>
                                <td>@op.GroupName</td>
                                <td>@op.Trimester</td>
                                <td>
                                    @op.Message
                                    @if (!string.IsNullOrWhiteSpace(op.ReviewHint))
                                    {
                                        <div class="small text-muted">@op.ReviewHint</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(op.ErrorCode))
                                    {
                                        <div class="small text-muted">@op.ErrorCode</div>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <a class="btn btn-primary" asp-action="Index">Volver a Importación de notas</a>
</div>
