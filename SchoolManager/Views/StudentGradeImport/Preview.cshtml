@model SchoolManager.Dtos.GradeImportPreviewDto
@{
    ViewData["Title"] = "Preview de importación de notas";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0"><i class="fas fa-table"></i> Preview de importación</h2>
        <a class="btn btn-outline-secondary" asp-action="Index">Analizar otro archivo</a>
    </div>

    @{
        var validCount = Model.NewCount + Model.UpdateCount + Model.UnchangedCount;
    }
    @if (validCount == 0)
    {
        <div class="alert alert-danger">
            No hay filas válidas para importar. Corrija los errores y vuelva a analizar el archivo.
        </div>
    }
    else if (Model.ErrorCount > 0)
    {
        <div class="alert alert-warning">
            Se importarán solo las filas válidas. Las @Model.ErrorCount filas con error se omitirán y no se modificarán.
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Las notas no se guardarán hasta que confirme la importación. El servidor volverá a validar el lote.
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3"><strong>Archivo:</strong> @Model.FileName</div>
                <div class="col-md-3"><strong>Hoja:</strong> @Model.SheetName</div>
                <div class="col-md-3"><strong>Año académico:</strong> @Model.AcademicYearName</div>
                <div class="col-md-3"><strong>Filas:</strong> @Model.TotalRows</div>
            </div>
            <div class="row mt-2">
                <div class="col-md-3"><strong>Operaciones:</strong> @Model.TotalOperations</div>
                <div class="col-md-2"><span class="badge bg-success">NUEVO @Model.NewCount</span></div>
                <div class="col-md-2"><span class="badge bg-warning text-dark">ACTUALIZAR @Model.UpdateCount</span></div>
                <div class="col-md-2"><span class="badge bg-secondary">SIN CAMBIOS @Model.UnchangedCount</span></div>
                <div class="col-md-2"><span class="badge bg-danger">ERROR @Model.ErrorCount</span></div>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <div class="btn-group" role="group" aria-label="Filtro de preview">
            <button type="button" class="btn btn-outline-primary active" data-filter="ALL">Todos</button>
            <button type="button" class="btn btn-outline-success" data-filter="NUEVO">Nuevos</button>
            <button type="button" class="btn btn-outline-warning" data-filter="ACTUALIZAR">Actualizaciones</button>
            <button type="button" class="btn btn-outline-secondary" data-filter="SIN CAMBIOS">Sin cambios</button>
            <button type="button" class="btn btn-outline-danger" data-filter="ERROR">Errores</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle" id="preview-table">
            <thead class="table-light">
                <tr>
                    <th>Estado</th>
                    <th>Fila</th>
                    <th>Documento</th>
                    <th>Estudiante</th>
                    <th>Asignatura</th>
                    <th>Grado</th>
                    <th>Grupo</th>
                    <th>Trimestre</th>
                    <th>Origen actual</th>
                    <th>Nota actual</th>
                    <th>Nota nueva</th>
                    <th>Observación</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var op in Model.Operations)
            {
                var badge = op.Status switch
                {
                    "NUEVO" => "bg-success",
                    "ACTUALIZAR" => "bg-warning text-dark",
                    "SIN CAMBIOS" => "bg-secondary",
                    _ => "bg-danger"
                };
                <tr data-status="@op.Status" data-error-code="@op.ErrorCode">
                    <td><span class="badge @badge">@op.Status</span></td>
                    <td>@op.RowNumber</td>
                    <td>@op.DocumentId</td>
                    <td>@op.StudentName</td>
                    <td>@op.SubjectName</td>
                    <td>@op.GradeName</td>
                    <td>@op.GroupName</td>
                    <td>@op.Trimester</td>
                    <td>@op.CurrentOrigin</td>
                    <td>@(string.IsNullOrWhiteSpace(op.CurrentDisplay) ? "—" : op.CurrentDisplay)</td>
                    <td>@(string.IsNullOrWhiteSpace(op.NewDisplay) ? "—" : op.NewDisplay)</td>
                    <td>
                        @op.Message
                        @if (!string.IsNullOrWhiteSpace(op.ReviewHint))
                        {
                            <div class="small text-muted">@op.ReviewHint</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(op.FoundValue) && op.Status == "ERROR")
                        {
                            <div class="small text-muted">Encontrado: @op.FoundValue</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(op.ErrorCode))
                        {
                            <div class="small text-muted">@op.ErrorCode</div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="card mt-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                @if (validCount == 0)
                {
                    <span class="text-danger">No hay filas válidas para importar.</span>
                }
                else if (Model.ErrorCount > 0)
                {
                    <span class="text-muted">
                        Se guardarán @Model.NewCount nuevas y @Model.UpdateCount actualizaciones. Se omitirán @Model.ErrorCount filas con error.
                    </span>
                }
                else
                {
                    <span class="text-muted">
                        Se importarán @Model.NewCount notas nuevas y se actualizarán @Model.UpdateCount notas existentes.
                    </span>
                }
            </div>
            <form asp-action="Confirm" method="post" id="confirm-import-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="previewToken" value="@Model.PreviewToken" />
                <button type="submit" class="btn btn-primary" id="confirm-import-btn"
                        disabled="@(validCount == 0 ? "disabled" : null)">
                    Confirmar importación
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-filter]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('[data-filter]').forEach(function (b) { b.classList.remove('active'); });
                btn.classList.add('active');
                var filter = btn.getAttribute('data-filter');
                document.querySelectorAll('#preview-table tbody tr').forEach(function (row) {
                    row.style.display = (filter === 'ALL' || row.getAttribute('data-status') === filter) ? '' : 'none';
                });
            });
        });

        var form = document.getElementById('confirm-import-form');
        var confirmBtn = document.getElementById('confirm-import-btn');
        if (form && confirmBtn && !confirmBtn.disabled) {
            form.addEventListener('submit', function (e) {
                var message = 'Se importarán @Model.NewCount notas nuevas y se actualizarán @Model.UpdateCount. Las @Model.ErrorCount filas con error se omitirán y no se modificarán.';
                if (!confirm(message)) {
                    e.preventDefault();
                    return;
                }
                confirmBtn.disabled = true;
                confirmBtn.innerText = 'Importando...';
            });
        }
    </script>
}
